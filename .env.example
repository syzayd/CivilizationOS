# Copy this file to .env and fill in keys. .env is gitignored.

# --- Brain routing ---
# PREMIUM_MODE=true  -> council debates use Claude (Tier 2). Costs a few $.
# PREMIUM_MODE=false -> entire app runs on local Ollama + free Gemini ($0).
PREMIUM_MODE=false

# Hard ceiling (USD) on Tier-2 Claude spend this process. Router refuses past this.
TIER2_BUDGET_USD=15.0

# --- Tier 0: local Ollama (free, unlimited) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Tier 1: Google Gemini free tier (get key at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Tier 2: Anthropic Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
CLAUDE_MEMBER_MODEL=claude-haiku-4-5
CLAUDE_SYNTH_MODEL=claude-sonnet-4-6

# --- Unified OpenRouter option (takes over Tier.FREE + Tier.PREMIUM instead of
# Gemini/Claude when set - used for the cloud deploy where a single key beats
# juggling three). Get a key at https://openrouter.ai/keys and pick model slugs
# from https://openrouter.ai/models - no defaults are guessed here. ---
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=
OPENROUTER_PREMIUM_MODEL=
# Approximate $/1M-token cost of the two models above, for the existing
# TIER2_BUDGET_USD spend cap - check openrouter.ai/models for current pricing.
OPENROUTER_FREE_PRICE_IN=0.0
OPENROUTER_FREE_PRICE_OUT=0.0
OPENROUTER_PREMIUM_PRICE_IN=0.0
OPENROUTER_PREMIUM_PRICE_OUT=0.0

# --- Demo mode (public deploy) ---
# true  -> ambient loop (citizen small talk, reflection, emergent crises) is
#          off; crisis injection / council debates stay fully live, on-demand.
# false -> full simulation, as in local dev.
DEMO_MODE=false
# Minimum seconds between POST /crisis requests, globally.
CRISIS_COOLDOWN_S=30.0

# --- CORS (comma-separated origins allowed to call this API) ---
# Add the deployed Vercel URL here once the frontend is live, e.g.:
# CORS_ORIGINS=http://localhost:5173,https://civilizationos.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
